{
	"compilerOptions": {
		"target": "es2019",
		"module": "esnext",
		"moduleResolution": "node",
		"jsx": "react",
		"lib": [ "dom", "es2019" ],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": false,
		"sourceMap": false
	},
	"include": [ "blocks/src/**/*" ]
}
